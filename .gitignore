# O repositorio publica a pagina online (GitHub Pages).
# Entra no GitHub apenas o que o site carrega:
#   index.html, login.js, modal-config.*, style-index.css,
#   SAC1.html + style1.css + js1/, SAC2.html + style2.css + js2/
# Todo o resto fica só na maquina.

# ==================== DOCUMENTACAO LOCAL ====================
*.md
!README.md

# ==================== CONFIG DO BACKEND FIREBASE ====================
# firestore.rules, firestore.indexes.json e firebase.json
# sao usados no deploy do Firebase, nao pela pagina.
firebase.json
firestore.rules
firestore.indexes.json

# ==================== CODIGO MORTO ====================
# Nenhuma pagina carrega js1/produtividade.js: o CD1 nao usa
# produtividade e a aba e oculta por CSS (.cd2-only).
js1/produtividade.js

